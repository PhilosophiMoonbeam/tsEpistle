  "name": "tsfranki",
  "version": "0.1.0-alpha.1",
  "releaseDate": "2026-08-13T00:00:00.000Z",
  "description": "tsFranki, an independent community fork of Wiki.js",
  "main": "server/index.ts",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "dev": false,
  "scripts": {
    "start": "bun server/index.ts",
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "NODE_ENV=development bun --watch server/index.ts",
    "dev:client": "bun --bun vite --host 127.0.0.1",
    "build": "bun server/scripts/generate-build-metadata.ts && bun --bun vite build && bun server/scripts/check-bundle-budgets.ts",
    "bundle:check": "bun server/scripts/check-bundle-budgets.ts",
    "dependencies:check": "bun server/scripts/check-dependency-policy.ts",
    "openapi:check": "bun server/scripts/check-openapi.ts && REDOCLY_SUPPRESS_UPDATE_NOTICE=true REDOCLY_TELEMETRY=off bun --bun redocly lint node_modules/.cache/wiki/openapi-v1.json --lint-config=error",
    "placeholders:check": "bun server/scripts/check-production-placeholders.ts",
    "benchmark:page-index": "dev/e2e/page-index-benchmark.sh",
    "scarlett:report": "bun server/scripts/check-scarlett-upstream.ts --fetch",
    "agents:maintenance": "bun server/scripts/agent-maintenance.ts",
    "agents:release-check": "bun server/scripts/check-agent-release.ts",
    "threat-model:check": "bun server/scripts/check-threat-model.ts",
    "scarlett:check": "bun server/scripts/check-scarlett-upstream.ts --fetch --check",
    "watch": "bun run dev",
    "format": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "typecheck:shared": "bun --bun tsc -b tsconfig.shared.json --pretty false",
    "test": "bun server/scripts/run-tests.ts",
    "typecheck:client": "bun server/scripts/run-vue-tsc.ts -p tsconfig.client.json --noEmit --pretty false",
    "typecheck:server": "bun --bun tsc -p tsconfig.server.json --noEmit --pretty false",
    "e2e": "bun --bun playwright test",
    "e2e:responsive": "bun --bun playwright test --project=responsive-chromium-desktop --project=responsive-firefox-desktop --project=responsive-webkit-desktop --project=responsive-chromium-wide --project=responsive-chromium-tablet --project=responsive-chromium-mobile --project=responsive-webkit-mobile --project=responsive-webkit-mobile-landscape",
    "docker:build": "bun server/scripts/build-docker.ts",
    "licenses:inventory": "bun server/scripts/generate-license-inventory.ts",
    "licenses:check": "bun server/scripts/generate-license-inventory.ts --check",
    "test:security": "bun server/scripts/run-tests.ts server/test/helpers/page-access.test.ts server/test/core/auth.page-rules.test.ts server/test/core/auth.api-access.test.ts server/test/helpers/auth-rate-limiter.test.js server/test/core/trust-proxy.test.ts server/test/controllers/auth.test.js server/test/controllers/api.auth.test.js server/test/controllers/common.private-routing.test.js server/test/models/pages.private-errors.test.js server/test/operations.assets.test.js server/test/operations.comments.visibility.test.js server/test/operations.pages.history-visibility.test.js server/test/operations.pages.search.test.js server/test/modules.search.db.visibility.test.js server/test/modules.rendering.html-core.visibility.test.js server/test/operations/page-protection.test.ts server/test/core/webhooks.test.js server/test/content-extensions/renderer.test.ts server/test/content-extensions/api.test.ts server/test/core/collaboration.test.ts server/test/db/migration-preflight.test.ts",
    "ci:static": "bun run dependencies:check && bun run licenses:check && bun run lint && bun run typecheck:shared && bun run typecheck:client && bun run typecheck:server && bun run openapi:check && bun run placeholders:check && bun run agents:release-check && bun run threat-model:check",
    "ci": "bun run ci:static && bun run test && bun run build"
  },
