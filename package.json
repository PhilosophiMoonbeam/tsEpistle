  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "dev": true,
  "scripts": {
    "start": "node server/index.ts",
    "dev": "pnpm run --parallel '/^dev:(client|server)$/'",
    "dev:server": "cross-env NODE_ENV=development node --watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "watch": "pnpm run dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck:client": "vue-tsc -p tsconfig.client.json --noEmit --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit --pretty false",
    "e2e": "playwright test",
    "postinstall": "patch-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Requarks/wiki.git"
  },
  "keywords": [
