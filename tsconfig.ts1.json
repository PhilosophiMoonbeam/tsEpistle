{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "client/helpers/*-api.js",
    "client/helpers/page-actions.js",
    "client/helpers/root-ui-store.js",
    "client/helpers/search-navigation-events.ts",
    "client/helpers/page-action-events.ts",
    "client/helpers/editor-conflict-events.ts",
    "client/helpers/editor-insert-events.ts",
    "client/helpers/editor-link-events.ts",
    "client/helpers/simple-event-bus.ts",
    "client/helpers/compatibility.js",
    "client/helpers/index.js",
    "client/polyfills/array-from.js",
    "client/components/editor/common/katex.js",
    "client/components/editor/markdown/tabset.js",
    "client/components/editor/common/cmFold.js",
    "client/components/editor/markdown/plantuml.js",
    "client/index-legacy.js",
    "client/.modernizrrc.js",
    "client/index-setup.js",
    "client/client-setup.js",
    "client/client-app.js",
    "client/index-app.js",
    "client/modules/boot.js",
    "client/modules/localization.js",
    "client/store/index.js",
    "client/store/admin.js",
    "client/store/editor.js",
    "client/store/page.js",
    "client/store/site.js",
    "client/store/user.js"
  ],
  "exclude": [
    "node_modules",
    "assets",
    "dev",
    "server",
    "test",
    "client/**/*.test.js",
    "client/**/*.vue",
    "client/graph/**/*",
    "client/libs/**/*",
    "client/themes/**/*",
    "client/scss/**/*"
  ]
}
