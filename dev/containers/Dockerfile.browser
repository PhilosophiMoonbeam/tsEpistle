# syntax=docker/dockerfile:1.7
FROM oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598

WORKDIR /srv/wiki
ENV NODE_ENV=production \
    HOME=/tmp \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json bun.lock ./
COPY patches ./patches
RUN bun install --production --frozen-lockfile && \
    bun --bun playwright-core install --with-deps chromium && \
    rm -rf /root/.bun/install/cache && \
    chown -R bun:bun /srv/wiki /ms-playwright
COPY --chown=bun:bun server/agents/browser ./server/agents/browser
COPY --chown=bun:bun server/helpers/canonical-json.ts ./server/helpers/canonical-json.ts
COPY --chown=bun:bun shared/agents ./shared/agents

USER bun
EXPOSE 9443
ENTRYPOINT ["bun", "server/agents/browser/worker.ts"]
