# syntax=docker/dockerfile:1.7
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d

ARG TARGETARCH
ARG WIKI_BUILD_REVISION=unknown
LABEL org.opencontainers.image.title="tsEpistle isolated agent browser worker" \
      org.opencontainers.image.revision="$WIKI_BUILD_REVISION" \
      org.opencontainers.image.source="https://github.com/PhilosophiMoonbeam/tsEpistle"

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    AGENT_BROWSER_PORT=9443 \
    AGENT_BROWSER_MAX_CONTEXTS=8
WORKDIR /wiki

COPY package.json bun.lock ./
COPY patches ./patches
RUN bun install --production --frozen-lockfile && \
    bun --bun playwright-core install --with-deps chromium && \
    rm -rf /root/.bun/install/cache && \
    chown -R bun:bun /wiki /ms-playwright
COPY --chown=bun:bun server ./server
COPY --chown=bun:bun shared ./shared
COPY --chown=bun:bun tsconfig.server.json tsconfig.shared.json ./

USER bun
RUN bun server/scripts/check-agent-browser-install.ts "$TARGETARCH"
EXPOSE 9443
ENTRYPOINT ["bun", "server/agents/browser/worker.ts"]
