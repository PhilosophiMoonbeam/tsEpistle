{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": false,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./client/*"]
    }
  },
  "references": [
    { "path": "./tsconfig.shared.json" }
  ],
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug", "./server/scripts/vue-search-element.cjs"],
    "strictTemplates": true,
    "fallthroughAttributes": true,
    "htmlAttributes": [
      "aria-activedescendant", "aria-atomic", "aria-autocomplete", "aria-busy", "aria-checked", "aria-controls",
      "aria-current", "aria-describedby", "aria-description", "aria-disabled", "aria-expanded",
      "aria-haspopup", "aria-hidden", "aria-invalid", "aria-keyshortcuts",
      "aria-label", "aria-labelledby", "aria-live", "aria-modal",
      "aria-multiselectable", "aria-pressed", "aria-roledescription",
      "aria-selected", "aria-valuetext"
    ],
    "dataAttributes": ["data-*"]
  },
  "include": [
    "client/**/*.ts",
    "client/**/*.vue",
    "client/**/*.d.ts",
    "vite.config.mts"
  ],
  "exclude": [
    "client/**/*.test.*",
    "client/**/*.js",
    "client/graph/**",
    "client/libs/**",
    "node_modules",
    "assets"
  ]
}
