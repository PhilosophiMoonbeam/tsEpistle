# Use a reviewed immutable tag or, preferably, a registry digest.
TSEPISTLE_IMAGE=ghcr.io/philosophimoonbeam/wiki:0.1.0-alpha.1

# These are infrastructure identities, not public hostnames.
TSEPISTLE_PROJECT_NAME=tsepistle
TSEPISTLE_POSTGRES_VOLUME=tsepistle-postgres
TSEPISTLE_PROXY_NETWORK=tsepistle-proxy
TSEPISTLE_PROXY_ALIAS=tsepistle

# Passwords, Agent keys, copied Wiki data, and backups live below this path.
TSEPISTLE_STATE_DIR=/opt/tsepistle
