extends master.pug

block head
  if injectCode.css
    style(type='text/css')!= injectCode.css
  if injectCode.head
    != injectCode.head
  if commentsEnabled
    != comments.head

block body
  -
    const wikiPagePayload = {
      version: 1,
      spaNavigation,
      pageFeatures,
      ratingsSiteEnabled,
      props: {
        pageId: page.id,
        locale: page.localeCode,
        path: page.path,
        title: page.title,
        description: page.description,
        tags: page.tags,
        createdAt: page.createdAt,
        updatedAt: page.updatedAt,
        sourceRevision: page.sourceRevision,
        lifecycleNotices,
        authorName: pageFeatures.lastEditorVisible ? page.authorName : 'Unknown',
        authorId: pageFeatures.lastEditorVisible ? page.authorId : 0,
        editor: page.editorKey,
        isPublished: Boolean(page.isPublished),
        effectiveIsPublished: typeof effectiveIsPublished !== 'undefined' && effectiveIsPublished === true,
        publicSharingEligible: typeof publicSharingEligible !== 'undefined' && publicSharingEligible === true,
        publishStartDate: page.publishStartDate || null,
        publishEndDate: page.publishEndDate || null,
        visibility: page.visibility,
        toc: Buffer.from(page.toc).toString('base64'),
        sidebar: Buffer.from(JSON.stringify(sidebar)).toString('base64'),
        navMode: config.nav.mode,
        navExpandParent: config.nav.expandParent !== false,
        commentsEnabled: commentsEnabled,
        effectivePermissions: Buffer.from(JSON.stringify(effectivePermissions)).toString('base64'),
        commentsExternal: Boolean(comments.codeTemplate),
        editShortcuts: Buffer.from(JSON.stringify(config.editShortcuts)).toString('base64'),
        filename: pageFilename,
        branding
      }
    }
  #root
    wiki-page(
      data-wiki-page-shell
      payload=Buffer.from(JSON.stringify(wikiPagePayload)).toString('base64')
      )
      template(v-slot:contents data-wiki-page-contents)
        .wiki-page-rendered-contents!= page.render
      template(v-slot:comments data-wiki-page-comments)
        div!= comments.main
  noscript
    main(lang=passiveLocale dir=passiveDirection)
      nav(aria-label='Site')
        a(href=passiveHome)= config.title
      article
        header
          h1= page.title
          if page.description
            p= page.description
        each notice in lifecycleNotices
          aside(role='note' aria-labelledby=`passive-lifecycle-notice-${page.id}-${notice.ruleId}` data-lifecycle-rule-id=notice.ruleId)
            strong(id=`passive-lifecycle-notice-${page.id}-${notice.ruleId}`)= t('common:page.automatedLifecycleNotice', { defaultValue: 'Automated lifecycle notice' })
            p(style='white-space: pre-wrap; overflow-wrap: anywhere')= notice.text
            small= t('common:page.lifecycleNoticeRule', { id: notice.ruleId, defaultValue: 'Rule {{id}}' })
        .contents!= passiveContent
  if injectCode.body
    != injectCode.body
  if commentsEnabled
    != comments.body
