doctype html
html
  head
    meta(http-equiv='X-UA-Compatible', content='IE=edge')
    meta(charset='UTF-8')
    meta(name='viewport', content='user-scalable=yes, width=device-width, initial-scale=1, maximum-scale=5')
    meta(name='theme-color', content='#4f46e5')
    meta(name='msapplication-TileColor', content='#4f46e5')
    meta(name='msapplication-TileImage', content='/_assets/favicons/mstile-150x150.png')
    title= product.name + ' Setup'

    //- Favicon
    link(rel='apple-touch-icon', sizes='180x180', href='/_assets/favicons/apple-touch-icon.png')
    link(rel='icon', type='image/png', sizes='192x192', href='/_assets/favicons/android-chrome-192x192.png')
    link(rel='icon', type='image/png', sizes='32x32', href='/_assets/favicons/favicon-32x32.png')
    link(rel='icon', type='image/png', sizes='16x16', href='/_assets/favicons/favicon-16x16.png')
    link(rel='mask-icon', href='/_assets/favicons/safari-pinned-tab.svg', color='#4f46e5')
    link(rel='manifest', href='/_assets/manifest-tsepistle.json')

    //- Product Metadata
    script.
      var siteConfig = !{JSON.stringify({ title: config.title, product })}

    //- Application assets
    if vite.client
      script(type='module', src=vite.client)
    each stylesheet in vite.css
      link(rel='stylesheet', href=stylesheet)
    each preload in vite.preloads
      link(rel='modulepreload', href=preload)
    script(type='module', src=vite.file)

  body
    #root
      setup
