doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, maximum-scale=5')
    meta(name='referrer', content='no-referrer')
    meta(name='theme-color', content='#1976d2')
    title Wiki Agents
    if agentVite.client
      script(type='module', src=agentVite.client)
    each stylesheet in agentVite.css
      link(rel='stylesheet', href=stylesheet)
    each preload in agentVite.preloads
      link(rel='modulepreload', href=preload)
    script(type='module', src=agentVite.file)
  body
    #agent-root(data-bootstrap=agentBootstrap)
