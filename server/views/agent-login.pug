doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, maximum-scale=5')
    meta(name='referrer', content='no-referrer')
    meta(name='theme-color', content='#1976d2')
    title Sign in | Wiki Agents
    style.
      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
      body { align-items: center; background: #eef2f7; color: #172033; display: flex; justify-content: center; margin: 0; min-height: 100vh; }
      main { background: #fff; border: 1px solid #d9e0ea; border-radius: 12px; box-shadow: 0 12px 36px rgb(23 32 51 / 12%); box-sizing: border-box; max-width: 28rem; padding: 2rem; width: calc(100% - 2rem); }
      h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
      p { color: #526071; margin: 0 0 1.5rem; }
      form { display: grid; gap: .75rem; }
      label { font-weight: 600; }
      input { background: #fff; border: 1px solid #aeb8c5; border-radius: 6px; box-sizing: border-box; color: #172033; font: inherit; padding: .75rem; width: 100%; }
      input:focus { border-color: #1976d2; outline: 3px solid rgb(25 118 210 / 20%); }
      button, a { background: #1976d2; border: 0; border-radius: 6px; color: #fff; cursor: pointer; display: block; font: inherit; font-weight: 700; padding: .75rem 1rem; text-align: center; text-decoration: none; }
      ul { display: grid; gap: .75rem; list-style: none; margin: 0; padding: 0; }
      @media (prefers-color-scheme: dark) { body { background: #111827; color: #f3f4f6; } main { background: #1f2937; border-color: #465468; } p { color: #c2cada; } input { background: #111827; border-color: #69768a; color: #f3f4f6; } }
  body
    main
      h1 Sign in to Wiki Agents
      if strategy
        p Use #{strategy.displayName} to continue to the isolated agent application.
        form(method='post', action=strategy.callbackPath)
          input(type='hidden', name='state', value=state)
          label(for='agent-email') Email
          input#agent-email(type='email', name='email', autocomplete='username', required, autofocus)
          label(for='agent-password') Password
          input#agent-password(type='password', name='password', autocomplete='current-password', required)
          button(type='submit') Sign in
      else if strategies && strategies.length
        p Choose an authentication provider.
        ul
          each item in strategies
            li
              a(href=item.href) Continue with #{item.displayName}
      else
        p No agent authentication strategy is available. Ask an administrator to enable one.
