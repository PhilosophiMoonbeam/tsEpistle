extends master.pug

block body
  #root.is-fullscreen
    main.app-error(aria-labelledby='app-error-title')
      section.app-error-content(role='alert')
        header.app-error-context
          a.app-error-brand(href='/', aria-label='Return home')
            img(
              src=siteConfig.logoUrl || '/_assets/svg/logo-tsepistle.svg'
              alt=''
            )
            span.app-error-workspace-title= siteConfig.title || config.title || 'Workspace'
          .app-error-eyebrow Request interrupted
          h1#app-error-title Something went wrong
          p.app-error-message= message
        .app-error-recovery
          a.app-error-home(href='/') Return home
          if error.stack
            details.app-error-details
              summary Technical details
              pre: code #{error.stack}
