index 0000000000000000000000000000000000000000..7c3ee7a2ab090006705aa6e7262ab68f9fa6012b
--- /dev/null
+++ b/lib/bun.js
@@ -0,0 +1,63 @@
+'use strict';
+
+const { Database: BunDatabase } = require('bun:sqlite');
+
+class Database {
+	constructor(filename, options = {}) {
+		this.database = options.readonly
+			? new BunDatabase(filename, { readonly: true })
+			: new BunDatabase(filename);
+		this.database.exec('PRAGMA foreign_keys = ON');
+		this.safeIntegers = false;
+	}
+
+	prepare(sql) {
+		const statement = this.database.prepare(sql);
+		statement.safeIntegers(this.safeIntegers);
+		Object.defineProperty(statement, 'reader', {
+			configurable: true,
+			enumerable: true,
+			get: () => statement.columnNames.length > 0,
+		});
+		return statement;
+	}
+
+	exec(sql) {
+		return this.database.exec(sql);
+	}
+
+	close() {
+		return this.database.close();
+	}
+
+	defaultSafeIntegers(enabled = true) {
+		this.safeIntegers = Boolean(enabled);
+		return this;
+	}
+
+	loadExtension(...args) {
+		return this.database.loadExtension(...args);
+	}
+
+	serialize(...args) {
+		return this.database.serialize(...args);
+	}
+
+	transaction(...args) {
+		return this.database.transaction(...args);
+	}
+
+	get inTransaction() {
+		return this.database.inTransaction;
+	}
+
+	get name() {
+		return this.database.filename;
+	}
+
+	get open() {
+		return !this.database.closed;
+	}
+}
+
+module.exports = Database;
