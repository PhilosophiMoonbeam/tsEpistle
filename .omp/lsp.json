{
  "servers": {
    "typescript-language-server": {
      "args": ["--stdio"]
    },
    "vue-language-server": {
      "args": ["--stdio"],
      "initOptions": {
        "typescript": {
          "tsdk": "node_modules/typescript/lib"
        },
        "vue": {
          "hybridMode": false
        }
      }
    }
  }
}
