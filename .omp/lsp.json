{
  "servers": {
    "typescript-language-server": {
      "args": ["--stdio"]
    },
    "vue-language-server": {
      "command": "npm",
      "args": ["exec", "--offline", "--yes", "--package=bun@1.4.3", "--", "bun", "--no-env-file", "server/scripts/vue-language-server.ts", "--stdio"]
    }
  }
}
