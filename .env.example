# Local browser smoke credentials. Copy to .env and keep that file private.
# SITE_URL is used by smoke tooling; it does NOT set the wiki's canonical host.
SITE_URL=https://wiki.example.org/
EMAIL=
PASSWORD=
# Optional smoke identity for existing offline drafts; do not replace a live value.
OFFLINE_DRAFT_SITE_ID=

# Native TypeSafe decision provider. Never commit a real API key.
# A nonempty inline value takes precedence over its corresponding _FILE.
TYPESAFE_API_KEY=
TYPESAFE_API_KEY_FILE=

# Generic external MCP OAuth is configured per endpoint in Administration or
# approved users' My tools. It requires no global Google client credentials.
# Register the generic callback using the wiki's canonical HTTPS host:
# https://wiki.example.org/agents/oauth/callback
# Automatic mode uses advertised client metadata or dynamic registration.
# Preregistered client IDs/secrets are entered through the endpoint's protected UI.
#
# Optional Google Workspace registration preset (separate from wiki sign-in).
# The preset keeps its already-agreed redirect URI:
# https://wiki.example.org/agents/oauth/google/callback
# Both callbacks derive their origin from the canonical wiki host, not SITE_URL.
# Other deployment origins need their own exact registered HTTPS callbacks.
# Google issues these optional values. Missing/partial credentials leave only
# the Google preset unconfigured; generic OAuth and none/bearer remain available.
# Prefer protected mounted files. Never expose credentials through VITE_*.
GOOGLE_WORKSPACE_MCP_CLIENT_ID=
GOOGLE_WORKSPACE_MCP_CLIENT_ID_FILE=
GOOGLE_WORKSPACE_MCP_CLIENT_SECRET=
GOOGLE_WORKSPACE_MCP_CLIENT_SECRET_FILE=

# Existing provider encryption/signing roots, required by the enabled agent runtime.
# Configure these through protected server mounts; never generate replacement
# roots merely to enable external OAuth. Preserve the maintained keyrings.
AGENT_PROVIDER_SECRET_KEYS_FILE=
AGENT_PROFILE_RESOLUTION_KEYS_FILE=
AGENT_SNAPSHOT_SIGNING_SECRET_FILE=

# .env is read by local Bun commands. Container services receive only their
# configured environment/mounts: changing this file does not update a deployment.
